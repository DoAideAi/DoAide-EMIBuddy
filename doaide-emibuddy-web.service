[Unit]
Description=DoAide EMIBuddy Web (serve built frontend)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/DoAide-EMIBuddy/frontend
# No -s: dist/serve.json (written by scripts/prerender-routes.mjs) maps each
# route to its prerendered HTML and ends with the SPA fallback.
ExecStart=/usr/bin/npx serve dist -l tcp://172.18.0.1:3082 --no-clipboard
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
